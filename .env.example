# ============================================================
#  GovScan AI — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ============================================================

# --- Gemini API ---
# Get your free API key from Google AI Studio:
#   https://aistudio.google.com/apikey
# Sign in with your Google account → "Create API key" → copy it here.
GEMINI_API_KEY=

# Which Gemini model to use (check AI Studio for current free models).
# As of Nov 2026, "gemini-3.8-flash" is the current free-tier model.
# Do NOT hardcode old names; verify at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Safety margin below the official free-tier daily limit (currently ~1500 RPD).
# The app stops making API calls when this count is reached in a calendar day.
GEMINI_DAILY_LIMIT=1400

# --- Telegram Bot ---
# 1. Open Telegram, search for @BotFather, start a chat.
# 2. Send /newbot, follow the prompts, copy the HTTP API token here.
TELEGRAM_BOT_TOKEN=

# 3. To get your personal chat ID:
#    a. Search for @userinfobot on Telegram and start it.
#    b. It replies with your numeric chat ID — paste it here.
TELEGRAM_CHAT_ID=

# --- Optional: Google Sheets sync (Phase 5) ---
# Leave blank until Phase 5.
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
